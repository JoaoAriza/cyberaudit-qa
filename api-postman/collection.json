{
  "info": {
    "name": "AUTH-01",
    "description": "Testes de validação de login de acordo com o seu tipo de usuario",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login - Usuário PRO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n \"email\": \"{{emailPro}}\",\n \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function (){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta tem token JWT\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
              "});",
              "",
              "pm.test(\"Conta com 2FA pede verificação em vez de liberar direto\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.requires2fa).to.eql(true);",
              "    pm.expect(body.user).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DOM-01 - Scan ativo em domínio não verificado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtPro}}"
          }
        ],
        "url": "{{baseUrl}}/scan?url={{scanHostNaoVerificado}}&active=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"DOM-01 - Status 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"DOM-01 - Erro de domínio não verificado\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error).to.eql(\"ACCOUNT_DOMAIN_NOT_VERIFIED\");",
              "});",
              "",
              "pm.test(\"DOM-01 - Host correto\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.host).to.eql(\"juice-shop:3000\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DOM-01 - Scan ativo sem autenticação",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/scan?url={{scanHostNaoVerificado}}&active=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"DOM-01 - Sem autenticação retorna 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"DOM-01 - Erro de autenticação\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error).to.eql(\"401 UNAUTHORIZED\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PAY-03 - Checkout PRO sem cardTokenId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtPro}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/billing/checkout/card",
        "body": {
          "mode": "raw",
          "raw": "{\"plan\": \"PRO\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"PAY-03 - Status 400\",function() {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"PAY-03 - BAD_REQUEST\",function() {",
              "    const body = pm.response.json();",
              "pm.expect(body.error).to.eql(\"400 BAD_REQUEST\");",
              "});",
              "pm.test(\"PAY-03 - Mensagem indica ausência de cardTokenId\",function() {",
              "const body = pm.response.json();",
              "pm.expect(body.message).to.include(\"cardTokenId ausente\")",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PAY-05 - Checkout Pix com CPF de tamanho inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtPro}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/billing/checkout/pix",
        "body": {
          "mode": "raw",
          "raw": "{\"plan\": \"Pro\",\n \"cpf\": \"123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"PAY-05 - Status 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",

              "pm.test(\"PAY-05 - Erro BAD_REQUEST\", function () {",
                  "const body = pm.response.json();",

                  "pm.expect(body.error).to.eql(\"400 BAD_REQUEST\");",
              "});",

              "pm.test(\"PAY-05 - Mensagem indica CPF com quantidade inválida de dígitos\", function () {",
              "    const body = pm.response.json();",

              "    pm.expect(body.message).to.include(\"informe os 11 dígitos\")",
              "});"
            ]
          }
        }
      ]
    }
],
"event": [
  {
    "listen": "prerequest",
    "script": {
      "type": "text/javascript",
      "exec": [
        "// INFRA (QA, Regra 3): forja um JWT HS256 de SESSAO do qa-pro em {{jwtPro}},",
        "// usando o mesmo segredo do ambiente de teste ({{jwtSecret}}). Dispensa o 2FA",
        "// nos casos que precisam de sessao (ex.: DOM-01). Roda antes de cada request.",
        "// As asserces (pm.test) de cada caso ficam em cada request, nao aqui.",
        "function b64url(wa){ return CryptoJS.enc.Base64.stringify(wa).split('+').join('-').split('/').join('_').split('=').join(''); }",
        "function b64urlStr(s){ return b64url(CryptoJS.enc.Utf8.parse(s)); }",
        "var now = Math.floor(Date.now() / 1000);",
        "var header = { alg: 'HS256', typ: 'JWT' };",
        "var payload = { sub: pm.environment.get('emailPro'), role: 'OWNER', userId: pm.environment.get('userIdPro'), name: 'QA Pro', twoFactorPending: false, iat: now, exp: now + 3600 };",
        "var signingInput = b64urlStr(JSON.stringify(header)) + '.' + b64urlStr(JSON.stringify(payload));",
        "var sig = b64url(CryptoJS.HmacSHA256(signingInput, pm.environment.get('jwtSecret')));",
        "pm.environment.set('jwtPro', signingInput + '.' + sig);"
      ]
    }
  }
]
}