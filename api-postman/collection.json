{
  "info": {
    "name": "testes Autenticação",
    "description": "Testes de validação de login de acordo com o seu tipo de usuario",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login - Usuário PRO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n \"email\": \"{{emailPro}}\",\n \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function (){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta tem token JWT\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
              "});",
              "",
              "pm.test(\"Conta com 2FA pede verificação em vez de liberar direto\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.requires2fa).to.eql(true);",
              "    pm.expect(body.user).to.be.null;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
