<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cyberaudit.qa</groupId>
    <artifactId>api-restassured</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
        Independente do Backend de propósito — RestAssured fala HTTP puro com a
        API rodando (local via docker-compose.test.yml), igual o Postman faz.
        Não importa nenhuma classe Java do repositório principal.
    -->

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <rest-assured.version>5.5.0</rest-assured.version>
        <junit.version>5.11.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
    </properties>

    <dependencies>
        <!-- Núcleo: given()/when()/then() + o client HTTP por baixo -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Validação de resposta contra um JSON Schema (pedido no escopo da Fase 3) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 — runner dos testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Assertions fluentes, complementa os matchers do RestAssured (Hamcrest) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            JJWT — só para o AUTH-03, que precisa FORJAR tokens do lado do teste:
            um token válido (controle positivo) e as variações inválidas (expirado,
            assinatura adulterada, alg:none). É a MESMA lib e versão que o Backend usa
            (io.jsonwebtoken 0.12.6), para assinar HS256 igual ao JwtUtil. O segredo do
            ambiente de teste vem do config.properties (jwt.secret) / variável de
            ambiente, nunca hardcoded no teste.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>test</scope>
            <!-- runtime na prática, mas test-scope basta: estes testes só rodam em test -->
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- maven-surefire-plugin é quem sabe rodar testes JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Lista cada teste no console com [OK]/[XX] e o @DisplayName, em vez de
                         só o total por classe. Extensão de terceiros (me.fabriciorby), só de
                         relatório — não afeta o que os testes fazem. -->
                    <reportFormat>plain</reportFormat>
                    <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter"/>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>me.fabriciorby</groupId>
                        <artifactId>maven-surefire-junit5-tree-reporter</artifactId>
                        <version>1.4.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
